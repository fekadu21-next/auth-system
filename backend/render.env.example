# Render Environment Variables Configuration
# Copy these to your Render dashboard environment variables

# Required Environment Variables for Production Deployment

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/syncwrite

# Session Security
SESSION_SECRET=your_super_secure_random_string_here

# Frontend URL (Vercel)
FRONTEND_URL=https://livedocs-brown.vercel.app

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://collaboration-editor-yfm8.onrender.com/api/auth/google/callback

# Cookie Domain (optional, only if needed for cross-domain cookies)
# COOKIE_DOMAIN=.onrender.com

# Node Environment
NODE_ENV=production
